  "anatomy": {"kind": "fish", "guidance": "Keep body axis, fin placement, tail plane, head profile, and gill region readable."},
  "anatomy_views": [
    {"view_id": "front", "role": "whole-body", "guidance": "Establish body depth, paired fin balance, and head alignment."},
    {"view_id": "side", "role": "fin", "guidance": "Show body contour, fin origins, gill line, and tail connection."},
    {"view_id": "rear", "role": "tail", "guidance": "Show caudal structure, tail width, and rear silhouette."},
    {"view_id": "top", "role": "silhouette", "guidance": "Show body footprint, dorsal fin, and lateral symmetry."},
    {"view_id": "underside", "role": "underside", "guidance": "Show belly contour, pelvic fins, and gill or mouth details."}
  ],
  "components": [
    {"id": "body", "name": "Body", "kind": "body"},
    {"id": "head", "name": "Head", "kind": "head"},
