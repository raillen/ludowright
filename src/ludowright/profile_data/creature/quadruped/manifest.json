    {"view_id": "front", "role": "whole-body", "guidance": "Establish front silhouette, stance width, and head alignment."},
    {"view_id": "side", "role": "limb", "guidance": "Show spine, leg articulation, paw contact, and body depth."},
    {"view_id": "rear", "role": "tail", "guidance": "Show hindquarter structure and tail attachment."},
    {"view_id": "top", "role": "silhouette", "guidance": "Show body width, limb spacing, and silhouette footprint."},
    {"view_id": "underside", "role": "underside", "guidance": "Show belly clearance and useful paw or attachment details."}
