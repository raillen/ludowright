        "invent-decision",
        "overwrite-approved-artifact"
      ],
      "guidance": [
        "Use the canonical asset registry and taxonomy before proposing a new asset.",
        "Preserve aggregate boundaries and explain prerequisite dependencies.",
        "Send ambiguous scope or destructive changes to the human checkpoint."
      ],
