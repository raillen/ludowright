{
  "$defs": {
    "GenerationOutputContract": {
      "additionalProperties": false,
      "description": "One generated reference and its exact immutable artifact identity.",
      "properties": {
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^[a-z0-9._-]+(?:/[a-z0-9._-]+)*$",
          "title": "Path",
          "type": "string"
        },
        "reference_id": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Reference Id",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/ReferenceRole"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 67108864,
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        },
        "validation": {
          "$ref": "#/$defs/GenerationOutputValidationContract"
        }
      },
      "required": [
        "reference_id",
        "role",
        "path",
        "sha256",
        "size_bytes",
        "validation"
      ],
      "title": "GenerationOutputContract",
      "type": "object"
    },
    "GenerationOutputValidationContract": {
      "additionalProperties": false,
      "description": "Bounded validation facts for one persisted generated PNG.",
      "properties": {
        "animated": {
          "const": false,
          "default": false,
          "title": "Animated",
          "type": "boolean"
        },
        "format": {
          "const": "png",
          "default": "png",
          "title": "Format",
          "type": "string"
        },
        "height": {
          "maximum": 4294967295,
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "width": {
          "maximum": 4294967295,
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "title": "GenerationOutputValidationContract",
      "type": "object"
    },
    "ReceiptStatus": {
      "description": "Terminal result of one generation attempt.",
      "enum": [
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "ReceiptStatus",
      "type": "string"
    },
    "ReferenceRole": {
      "description": "Production purpose served by a visual reference.",
      "enum": [
        "identity",
        "silhouette",
        "proportion",
        "construction",
        "material",
        "color",
        "style",
        "context",
        "negative",
        "output",
        "other"
      ],
      "title": "ReferenceRole",
      "type": "string"
    }
  },
  "$id": "https://schemas.ludowright.dev/v1/generation-receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt": {
      "maximum": 100,
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "completed_at": {
      "anyOf": [
        {
          "maxLength": 27,
          "minLength": 27,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "failure_note": {
      "anyOf": [
        {
          "maxLength": 4000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Note"
    },
    "id": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Id",
      "type": "string"
    },
    "job_id": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Job Id",
      "type": "string"
    },
    "kind": {
      "const": "generation-receipt",
      "default": "generation-receipt",
      "title": "Kind",
      "type": "string"
    },
    "model": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "operation_id": {
      "anyOf": [
        {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Operation Id"
    },
    "output_reference_ids": {
      "default": [],
      "items": {
        "maxLength": 80,
        "minLength": 1,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Output Reference Ids",
      "type": "array"
    },
    "outputs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/GenerationOutputContract"
      },
      "maxItems": 64,
      "title": "Outputs",
      "type": "array"
    },
    "prompt_hash": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Hash"
    },
    "provider": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "request_revision": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]*$",
      "title": "Request Revision",
      "type": "string"
    },
    "retry_of": {
      "anyOf": [
        {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retry Of"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "started_at": {
      "anyOf": [
        {
          "maxLength": 27,
          "minLength": 27,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "status": {
      "$ref": "#/$defs/ReceiptStatus"
    },
    "tool": {
      "anyOf": [
        {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tool"
    }
  },
  "required": [
    "id",
    "job_id",
    "attempt",
    "status",
    "provider",
    "model",
    "request_revision"
  ],
  "title": "LudoWright Generation Receipt",
  "type": "object"
}
