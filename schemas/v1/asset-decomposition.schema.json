{
  "$defs": {
    "AssetComponentContract": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "owner": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetOwnerContract"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "parent_id": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Id"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/AssetStatus",
          "default": "planned"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "AssetComponentContract",
      "type": "object"
    },
    "AssetDependencyContract": {
      "additionalProperties": false,
      "description": "One explicit prerequisite asset for the decomposed aggregate.",
      "properties": {
        "depends_on": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Depends On",
          "type": "string"
        },
        "invalidation_mode": {
          "$ref": "#/$defs/InvalidationMode",
          "default": "stale"
        }
      },
      "required": [
        "depends_on"
      ],
      "title": "AssetDependencyContract",
      "type": "object"
    },
    "AssetOwnerContract": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/OwnerKind"
        },
        "label": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "kind"
      ],
      "title": "AssetOwnerContract",
      "type": "object"
    },
    "AssetStateContract": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "owner": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetOwnerContract"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/AssetStatus",
          "default": "planned"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "AssetStateContract",
      "type": "object"
    },
    "AssetStatus": {
      "description": "Production progress shared by assets and decomposed items.",
      "enum": [
        "planned",
        "specified",
        "ready",
        "in-production",
        "in-review",
        "completed",
        "cancelled",
        "archived"
      ],
      "title": "AssetStatus",
      "type": "string"
    },
    "AssetVariantContract": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "owner": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetOwnerContract"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/AssetStatus",
          "default": "planned"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "AssetVariantContract",
      "type": "object"
    },
    "InvalidationMode": {
      "description": "How a source problem affects a dependent target.",
      "enum": [
        "stale",
        "review",
        "none"
      ],
      "title": "InvalidationMode",
      "type": "string"
    },
    "OwnerKind": {
      "description": "Kind of owner responsible for a production item.",
      "enum": [
        "person",
        "team",
        "role",
        "automation"
      ],
      "title": "OwnerKind",
      "type": "string"
    }
  },
  "$id": "https://schemas.ludowright.dev/v1/asset-decomposition.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Complete replacement payload for one asset's decomposition.",
  "properties": {
    "asset_id": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Asset Id",
      "type": "string"
    },
    "components": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AssetComponentContract"
      },
      "title": "Components",
      "type": "array"
    },
    "dependencies": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AssetDependencyContract"
      },
      "maxItems": 256,
      "title": "Dependencies",
      "type": "array"
    },
    "kind": {
      "const": "asset-decomposition",
      "default": "asset-decomposition",
      "title": "Kind",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "states": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AssetStateContract"
      },
      "title": "States",
      "type": "array"
    },
    "variants": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AssetVariantContract"
      },
      "title": "Variants",
      "type": "array"
    }
  },
  "required": [
    "asset_id"
  ],
  "title": "LudoWright Asset Decomposition",
  "type": "object"
}
