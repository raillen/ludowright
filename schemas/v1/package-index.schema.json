{
  "$defs": {
    "PackageIndexEntryContract": {
      "additionalProperties": false,
      "description": "One deterministic member described by the package index.",
      "properties": {
        "kind": {
          "enum": [
            "project-file",
            "package-manifest"
          ],
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 1073741824,
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "source_path": {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$",
          "title": "Source Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "source_path",
        "kind",
        "size_bytes",
        "sha256"
      ],
      "title": "PackageIndexEntryContract",
      "type": "object"
    }
  },
  "$id": "https://schemas.ludowright.dev/v1/package-index.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Published index for one reproducible ZIP package.",
  "properties": {
    "archive_index_path": {
      "const": "__ludowright__/package-index.json",
      "default": "__ludowright__/package-index.json",
      "title": "Archive Index Path",
      "type": "string"
    },
    "archive_manifest_path": {
      "const": "__ludowright__/package-manifest.json",
      "default": "__ludowright__/package-manifest.json",
      "title": "Archive Manifest Path",
      "type": "string"
    },
    "archive_member_count": {
      "maximum": 2147483647,
      "minimum": 0,
      "title": "Archive Member Count",
      "type": "integer"
    },
    "archive_path": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$",
      "title": "Archive Path",
      "type": "string"
    },
    "compression": {
      "const": "deflate",
      "default": "deflate",
      "title": "Compression",
      "type": "string"
    },
    "entries": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PackageIndexEntryContract"
      },
      "title": "Entries",
      "type": "array"
    },
    "index_path": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$",
      "title": "Index Path",
      "type": "string"
    },
    "kind": {
      "const": "package-index",
      "default": "package-index",
      "title": "Kind",
      "type": "string"
    },
    "manifest_path": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$",
      "title": "Manifest Path",
      "type": "string"
    },
    "manifest_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "package_id": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Package Id",
      "type": "string"
    },
    "payload_size_bytes": {
      "maximum": 1090519040,
      "minimum": 0,
      "title": "Payload Size Bytes",
      "type": "integer"
    },
    "project_id": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "zip_timestamp": {
      "const": "1980-01-01T00:00:00",
      "default": "1980-01-01T00:00:00",
      "title": "Zip Timestamp",
      "type": "string"
    }
  },
  "required": [
    "package_id",
    "project_id",
    "manifest_path",
    "manifest_sha256",
    "archive_path",
    "index_path",
    "archive_member_count",
    "payload_size_bytes"
  ],
  "title": "LudoWright Package Index",
  "type": "object"
}
