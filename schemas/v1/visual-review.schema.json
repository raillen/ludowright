{
  "$defs": {
    "ReviewActorContract": {
      "additionalProperties": false,
      "description": "Persisted review participant identity used by the policy boundary.",
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ReviewerKind"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "ReviewActorContract",
      "type": "object"
    },
    "ReviewerKind": {
      "description": "Trust class used by the review policy boundary.",
      "enum": [
        "human",
        "agent"
      ],
      "title": "ReviewerKind",
      "type": "string"
    },
    "VisualReviewOutcome": {
      "description": "Human review outcome for generated visual outputs.",
      "enum": [
        "accepted",
        "changes-requested",
        "rejected"
      ],
      "title": "VisualReviewOutcome",
      "type": "string"
    }
  },
  "$id": "https://schemas.ludowright.dev/v1/visual-review.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approval_id": {
      "anyOf": [
        {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approval Id"
    },
    "id": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "const": "visual-review",
      "default": "visual-review",
      "title": "Kind",
      "type": "string"
    },
    "note": {
      "anyOf": [
        {
          "maxLength": 4000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Note"
    },
    "outcome": {
      "$ref": "#/$defs/VisualReviewOutcome"
    },
    "producer": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReviewActorContract"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "receipt_id": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Receipt Id",
      "type": "string"
    },
    "reviewed_reference_ids": {
      "items": {
        "maxLength": 80,
        "minLength": 1,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Reviewed Reference Ids",
      "type": "array"
    },
    "reviewer": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReviewActorContract"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "supersedes": {
      "anyOf": [
        {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes"
    }
  },
  "required": [
    "id",
    "receipt_id",
    "outcome",
    "reviewed_reference_ids"
  ],
  "title": "LudoWright Visual Review",
  "type": "object"
}
