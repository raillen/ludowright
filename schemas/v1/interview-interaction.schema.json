{
  "$defs": {
    "InterviewBlockedQuestionContract": {
      "additionalProperties": false,
      "properties": {
        "question_id": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Question Id",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "unresolved_dependencies": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Unresolved Dependencies",
          "type": "array"
        }
      },
      "required": [
        "question_id",
        "unresolved_dependencies",
        "required"
      ],
      "title": "InterviewBlockedQuestionContract",
      "type": "object"
    },
    "InterviewProgressContract": {
      "additionalProperties": false,
      "properties": {
        "answered": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 1024,
          "title": "Answered",
          "type": "array"
        },
        "blocked": {
          "items": {
            "$ref": "#/$defs/InterviewBlockedQuestionContract"
          },
          "maxItems": 1024,
          "title": "Blocked",
          "type": "array"
        },
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "deferred": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 1024,
          "title": "Deferred",
          "type": "array"
        },
        "next_question": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Question"
        },
        "not_applicable": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 1024,
          "title": "Not Applicable",
          "type": "array"
        },
        "pending": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 1024,
          "title": "Pending",
          "type": "array"
        },
        "required_deferred": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 1024,
          "title": "Required Deferred",
          "type": "array"
        },
        "required_pending": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 1024,
          "title": "Required Pending",
          "type": "array"
        },
        "required_skipped": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 1024,
          "title": "Required Skipped",
          "type": "array"
        },
        "skipped": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 1024,
          "title": "Skipped",
          "type": "array"
        }
      },
      "required": [
        "pending",
        "required_pending",
        "blocked",
        "not_applicable",
        "answered",
        "skipped",
        "deferred",
        "required_skipped",
        "required_deferred",
        "complete"
      ],
      "title": "InterviewProgressContract",
      "type": "object"
    },
    "InterviewQuestionViewContract": {
      "additionalProperties": false,
      "description": "Question projection returned by the interactive CLI.",
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "options": {
          "default": [],
          "items": {
            "$ref": "#/$defs/QuestionOptionContract"
          },
          "maxItems": 128,
          "title": "Options",
          "type": "array"
        },
        "prompt": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "type": {
          "$ref": "#/$defs/QuestionType"
        }
      },
      "required": [
        "id",
        "prompt",
        "type",
        "required"
      ],
      "title": "InterviewQuestionViewContract",
      "type": "object"
    },
    "QuestionOptionContract": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "QuestionOptionContract",
      "type": "object"
    },
    "QuestionType": {
      "description": "Supported answer shapes for the first interview engine slice.",
      "enum": [
        "text",
        "single-choice",
        "multi-choice",
        "boolean",
        "integer",
        "number"
      ],
      "title": "QuestionType",
      "type": "string"
    }
  },
  "$id": "https://schemas.ludowright.dev/v1/interview-interaction.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Command-specific data carried inside the published CLI envelope.",
  "properties": {
    "changed": {
      "title": "Changed",
      "type": "boolean"
    },
    "kind": {
      "const": "interview-interaction",
      "default": "interview-interaction",
      "title": "Kind",
      "type": "string"
    },
    "operation": {
      "enum": [
        "next",
        "answer",
        "skip",
        "defer"
      ],
      "title": "Operation",
      "type": "string"
    },
    "progress": {
      "$ref": "#/$defs/InterviewProgressContract"
    },
    "question": {
      "anyOf": [
        {
          "$ref": "#/$defs/InterviewQuestionViewContract"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "questionnaire_id": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Questionnaire Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "session_id": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Session Id",
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "questionnaire_id",
    "operation",
    "changed",
    "progress"
  ],
  "title": "LudoWright Interview Interaction",
  "type": "object"
}
