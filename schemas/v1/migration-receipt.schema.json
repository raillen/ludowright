{
  "$defs": {
    "MigrationRunStatus": {
      "enum": [
        "prepared",
        "completed",
        "failed",
        "rolled-back"
      ],
      "title": "MigrationRunStatus",
      "type": "string"
    }
  },
  "$id": "https://schemas.ludowright.dev/v1/migration-receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Exact backup, execution, and rollback metadata for one migration run.",
  "properties": {
    "after_digest": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "After Digest"
    },
    "backup_digest": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Backup Digest",
      "type": "string"
    },
    "backup_path": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^[a-z0-9._-]+(?:/[a-z0-9._-]+)*$",
      "title": "Backup Path",
      "type": "string"
    },
    "before_digest": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Before Digest",
      "type": "string"
    },
    "completed_at": {
      "anyOf": [
        {
          "maxLength": 27,
          "minLength": 27,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "database_path": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^[a-z0-9._-]+(?:/[a-z0-9._-]+)*$",
      "title": "Database Path",
      "type": "string"
    },
    "failure": {
      "anyOf": [
        {
          "maxLength": 4000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure"
    },
    "kind": {
      "const": "migration-receipt",
      "default": "migration-receipt",
      "title": "Kind",
      "type": "string"
    },
    "migration_ids": {
      "items": {
        "maxLength": 80,
        "minLength": 1,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Migration Ids",
      "type": "array"
    },
    "pre_rollback_digest": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pre Rollback Digest"
    },
    "rolled_back_at": {
      "anyOf": [
        {
          "maxLength": 27,
          "minLength": 27,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rolled Back At"
    },
    "run_id": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_version": {
      "maximum": 2147483647,
      "minimum": 1,
      "title": "Source Version",
      "type": "integer"
    },
    "started_at": {
      "maxLength": 27,
      "minLength": 27,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/MigrationRunStatus"
    },
    "target_version": {
      "maximum": 2147483647,
      "minimum": 1,
      "title": "Target Version",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "status",
    "database_path",
    "backup_path",
    "source_version",
    "target_version",
    "migration_ids",
    "started_at",
    "before_digest",
    "backup_digest"
  ],
  "title": "LudoWright Migration Receipt",
  "type": "object"
}
