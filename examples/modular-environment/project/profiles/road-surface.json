  "sheets": [
    {"id": "road-turnaround", "name": "Road Turnaround", "layout": "turnaround", "view_ids": ["front", "top", "connections"], "subject_modes": ["asset", "components", "states"], "separate_files": true, "assembled_sheet": true, "required": true},
    {"id": "road-connections", "name": "Road Connections", "layout": "grid", "view_ids": ["connections", "top"], "subject_modes": ["components", "states"], "separate_files": true, "assembled_sheet": false, "required": true}
